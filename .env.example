# Backend Configuration (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost

# OpenStreetMap & Overpass API Configuration
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=GoodMapsAccessibilityPlatform/1.0 (contact: support@goodmaps.local)

# Cache Configuration (Caffeine)
CACHE_GEOCODING_TTL_HOURS=24
CACHE_ACTIVITIES_TTL_MINUTES=60
CACHE_MAX_SIZE=1000

# Frontend Configuration (Angular)
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080/api
