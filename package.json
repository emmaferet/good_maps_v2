{
  "name": "good-maps-monorepo",
  "version": "1.0.0",
  "description": "Good Maps Monorepo - Plateforme SaaS d'activités accessibles (Spring Boot 3 + Angular 19)",
  "scripts": {
    "start": "npm --prefix frontend start",
    "dev": "npm --prefix frontend start",
    "start:frontend": "npm --prefix frontend start",
    "start:backend": "node scripts/mvnw.js spring-boot:run",
    "build": "npm --prefix frontend run build && node scripts/mvnw.js package -DskipTests",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/mvnw.js package -DskipTests",
    "test:backend": "node scripts/mvnw.js test",
    "test:frontend": "npm --prefix frontend test"
  },
  "keywords": [
    "goodmaps",
    "accessibility",
    "openstreetmap",
    "angular",
    "springboot"
  ],
  "author": "Good Maps Team",
  "license": "MIT"
}
